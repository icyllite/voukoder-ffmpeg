diff --git a/libavcodec/libfdk-aac_internal.h b/libavcodec/libfdk-aac_internal.h
new file mode 100644
index 0000000..47afcb0
--- /dev/null
+++ b/libavcodec/libfdk-aac_internal.h
@@ -0,0 +1,110 @@
+/*
+ * Runtime dynamic loading of libfdk-aac.
+ *
+ * FFmpeg here is not linked against libfdk-aac. The FDK-AAC library is loaded
+ * at runtime from libfdk-aac-2.dll (Windows) / libfdk-aac.so.2 (POSIX) and the
+ * entry points used by the encoder/decoder wrappers are resolved through
+ * GetProcAddress()/dlsym(). This keeps the fdk-aac symbols out of the built
+ * FFmpeg libraries and avoids marking the build as --enable-nonfree.
+ *
+ * The DLL has to be discoverable by the default loader search path (next to
+ * the executable or on PATH on Windows, in the linker search path on POSIX).
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#ifndef AVCODEC_LIBFDK_AAC_INTERNAL_H
+#define AVCODEC_LIBFDK_AAC_INTERNAL_H
+
+#ifdef _WIN32
+#include <windows.h>
+#define FDK_AAC_LIBNAME  "libfdk-aac-2.dll"
+#define fdk_dlopen(name)         ((void *)LoadLibraryA(name))
+#define fdk_dlclose(handle)      FreeLibrary((HMODULE)(handle))
+#define fdk_dlsym(handle, name)  GetProcAddress((HMODULE)(handle), name)
+#else
+#include <dlfcn.h>
+#define FDK_AAC_LIBNAME  "libfdk-aac.so.2"
+#define fdk_dlopen(name)         dlopen(name, RTLD_NOW)
+#define fdk_dlclose(handle)      dlclose(handle)
+#define fdk_dlsym(handle, name)  dlsym(handle, name)
+#endif
+
+#include <fdk-aac/aacenc_lib.h>
+#include <fdk-aac/aacdecoder_lib.h>
+
+typedef AACENC_ERROR (*imp_aacEncOpen)(HANDLE_AACENCODER *phAacEncoder, const UINT encModules, const UINT maxChannels);
+typedef AACENC_ERROR (*imp_aacEncClose)(HANDLE_AACENCODER *phAacEncoder);
+typedef AACENC_ERROR (*imp_aacEncEncode)(const HANDLE_AACENCODER hAacEncoder, const AACENC_BufDesc *inBufDesc, const AACENC_BufDesc *outBufDesc, const AACENC_InArgs *inargs, AACENC_OutArgs *outargs);
+typedef AACENC_ERROR (*imp_aacEncInfo)(const HANDLE_AACENCODER hAacEncoder, AACENC_InfoStruct *pInfo);
+typedef AACENC_ERROR (*imp_aacEncoder_SetParam)(const HANDLE_AACENCODER hAacEncoder, const AACENC_PARAM param, const UINT value);
+
+/* Members are prefixed to keep them distinct from the macro names that
+ * redirect the entry points at the top of the wrapper sources. */
+typedef struct _aacEncLib {
+    imp_aacEncOpen          p_aacEncOpen;
+    imp_aacEncClose         p_aacEncClose;
+    imp_aacEncEncode        p_aacEncEncode;
+    imp_aacEncInfo          p_aacEncInfo;
+    imp_aacEncoder_SetParam p_aacEncoder_SetParam;
+} aacEncLib;
+
+typedef LINKSPEC_H HANDLE_AACDECODER (*imp_aacDecoder_Open)(TRANSPORT_TYPE transportFmt, UINT nrOfLayers);
+typedef LINKSPEC_H void (*imp_aacDecoder_Close)(HANDLE_AACDECODER self);
+typedef LINKSPEC_H AAC_DECODER_ERROR (*imp_aacDecoder_Fill)(HANDLE_AACDECODER self, UCHAR *pBuffer[], const UINT bufferSize[], UINT *bytesValid);
+typedef LINKSPEC_H AAC_DECODER_ERROR (*imp_aacDecoder_DecodeFrame)(HANDLE_AACDECODER self, INT_PCM *pTimeData, const UINT timeDataSize, const UINT flags);
+typedef LINKSPEC_H CStreamInfo *(*imp_aacDecoder_GetStreamInfo)(HANDLE_AACDECODER self);
+typedef LINKSPEC_H AAC_DECODER_ERROR (*imp_aacDecoder_ConfigRaw)(HANDLE_AACDECODER self, UCHAR *conf[], const UINT length[]);
+typedef LINKSPEC_H AAC_DECODER_ERROR (*imp_aacDecoder_SetParam)(const HANDLE_AACDECODER self, const AACDEC_PARAM param, const INT value);
+typedef LINKSPEC_H AAC_DECODER_ERROR (*imp_aacDecoder_AncDataInit)(HANDLE_AACDECODER self, UCHAR *buffer, int size);
+
+typedef struct _aacDecLib {
+    imp_aacDecoder_Open          p_aacDecoder_Open;
+    imp_aacDecoder_Close         p_aacDecoder_Close;
+    imp_aacDecoder_Fill          p_aacDecoder_Fill;
+    imp_aacDecoder_DecodeFrame   p_aacDecoder_DecodeFrame;
+    imp_aacDecoder_ConfigRaw     p_aacDecoder_ConfigRaw;
+    imp_aacDecoder_GetStreamInfo p_aacDecoder_GetStreamInfo;
+    imp_aacDecoder_SetParam      p_aacDecoder_SetParam;
+    imp_aacDecoder_AncDataInit   p_aacDecoder_AncDataInit;
+} aacDecLib;
+
+/* Resolves a single entry point. Both macros expect an AVCodecContext named
+ * "avctx" and a context named "s" holding a hLib/pfn pair. */
+#define FDK_ENC_BIND(field, type, sym)                                           \
+    do {                                                                         \
+        s->pfn.field = (type)fdk_dlsym(s->hLib, sym);                            \
+        if (!s->pfn.field) {                                                     \
+            av_log(avctx, AV_LOG_ERROR,                                          \
+                   "Unable to find symbol %s in dynamic " FDK_AAC_LIBNAME "\n",  \
+                   sym);                                                         \
+            return AVERROR_UNKNOWN;                                              \
+        }                                                                        \
+    } while (0)
+
+#define FDK_DEC_BIND(field, type, sym)                                           \
+    do {                                                                         \
+        s->pfn.field = (type)fdk_dlsym(s->hLib, sym);                            \
+        if (!s->pfn.field) {                                                     \
+            av_log(avctx, AV_LOG_ERROR,                                          \
+                   "Unable to find symbol %s in dynamic " FDK_AAC_LIBNAME "\n",  \
+                   sym);                                                         \
+            return AVERROR_UNKNOWN;                                              \
+        }                                                                        \
+    } while (0)
+
+#endif /* AVCODEC_LIBFDK_AAC_INTERNAL_H */
\ No newline at end of file
